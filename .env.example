# ============================================================
# Environment Variables — Backend Pekarang.in
# Copy file ini ke .env dan isi nilainya
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
# Jika pakai Docker Compose, nilai ini harus match dengan docker-compose.yml
DATABASE_URL=postgresql://pekarangin:pekarangin_secret@localhost:5432/pekarangin_dev

# ---- Authentication ----
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ---- Google OAuth ----
# Dapatkan dari Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ---- Gemini API ----
# Dapatkan dari Google AI Studio (https://aistudio.google.com/apikey)
# ⚠️ JANGAN PERNAH commit file .env ke repository!
GEMINI_API_KEY=your_gemini_api_key_here

# ---- AI Microservice (FastAPI) ----
# URL microservice Python/FastAPI (Opsi A)
AI_SERVICE_URL=https://ai-pekarangin-production.up.railway.app
